{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "familychat-access-standard",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FAMILY",
        "class_name": "FamilyChat"
      }
    ]
  },
  "exports": {
    "FamilyChat": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "AI_GATEWAY_ID": "",
    "ACCESS_ISSUER": "",
    "ACCESS_AUDIENCE": ""
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
